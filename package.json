{
  "name": "obsidian-video-transcription-knowledge",
  "version": "1.0.0",
  "description": "Plugin Obsidian pour extraire des connaissances depuis des vidéos multi-plateformes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "video",
    "transcription",
    "youtube",
    "knowledge",
    "ai",
    "llm"
  ],
  "author": "ZenitoGR",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.10",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "ytdl-core": "^4.11.5",
    "@google/generative-ai": "^0.1.3",
    "openai": "^4.20.1"
  }
}
